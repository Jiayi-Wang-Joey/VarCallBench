Bootstrap: docker
From: condaforge/mambaforge:latest

%post
    set -eux

    mamba install -y -c conda-forge -c bioconda \
        python=3.10 \
        samtools=1.21 \
        minimap2=2.28 \
        bcftools \
        tabix \
        gcc \
        zlib

    pip install --no-cache-dir \
        scipy==1.10.1 \
        isolaser==0.0.3

    mamba clean -afy

%environment
    export PATH=/opt/conda/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin

%runscript
    exec "$@"

%test
    set -eux
    /opt/conda/bin/python --version
    /opt/conda/bin/samtools --version
    /opt/conda/bin/minimap2 --version
    /opt/conda/bin/isolaser --help || true
    /opt/conda/bin/isolaser_annotate --help || true
